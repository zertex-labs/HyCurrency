# gRPC Server
GRPC_PORT=50051
GRPC_HOST=0.0.0.0

# PostgreSQL Database
DATABASE_URL=jdbc:postgresql://localhost:5432/hycurrency
DATABASE_USER=hycurrency
DATABASE_PASSWORD=hycurrency_dev
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_IDLE=2

# Valkey/Redis Cache
REDIS_URL=redis://localhost:6379
CACHE_BALANCE_TTL_SECONDS=5

# Idempotency
IDEMPOTENCY_TTL_HOURS=1

# Currency Configuration
CURRENCY_CONFIG_PATH=currencies.json
